---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booking Confirmed — Dr. Itzia Perez Morales"
  description="Your session has been confirmed."
>
  <div
    class="min-h-screen flex items-center justify-center px-6 py-24 pt-32"
    style="background: #FAF8F4;"
  >
    <div class="max-w-lg w-full">

      <!-- Success icon -->
      <div class="flex justify-center mb-10">
        <div class="relative">
          <div
            class="w-24 h-24 rounded-full flex items-center justify-center"
            style="background: rgba(29,78,95,0.08); border: 2px solid rgba(29,78,95,0.15);"
          >
            <svg
              viewBox="0 0 48 48"
              fill="none"
              class="w-10 h-10"
            >
              <path
                d="M10 24l10 10 18-18"
                stroke="#1D4E5F"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-dasharray="50"
                stroke-dashoffset="50"
                style="animation: drawCheck 0.7s ease forwards 0.3s;"
              />
            </svg>
          </div>
          <!-- Pulse ring -->
          <div
            class="absolute inset-0 rounded-full animate-ping opacity-20"
            style="background: rgba(29,78,95,0.3);"
          />
        </div>
      </div>

      <!-- Heading -->
      <div class="text-center mb-8">
        <h1 class="font-display text-display-sm text-warm mb-3">
          You're all booked in.
        </h1>
        <p id="booking-summary" class="text-sm leading-relaxed" style="color:#44403C;">
          Your confirmation has been sent to your email address.
        </p>
      </div>

      <!-- Booking details card -->
      <div
        id="details-card"
        class="rounded-2xl p-6 mb-6 hidden"
        style="background:white; border:1px solid rgba(29,78,95,0.08);"
      >
        <h2 class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#1D4E5F;">
          Booking Details
        </h2>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm" style="color:#78716C;">Service</span>
            <span id="detail-service" class="text-sm font-medium text-warm"></span>
          </div>
          <div class="h-px" style="background:rgba(29,78,95,0.07);"></div>
          <div class="flex items-center justify-between">
            <span class="text-sm" style="color:#78716C;">Date</span>
            <span id="detail-date" class="text-sm font-medium text-warm"></span>
          </div>
          <div class="h-px" style="background:rgba(29,78,95,0.07);"></div>
          <div class="flex items-center justify-between">
            <span class="text-sm" style="color:#78716C;">Time</span>
            <span id="detail-time" class="text-sm font-medium text-warm"></span>
          </div>
          <div class="h-px" style="background:rgba(29,78,95,0.07);"></div>
          <div class="flex items-center justify-between">
            <span class="text-sm" style="color:#78716C;">Amount paid</span>
            <span id="detail-price" class="font-display text-xl font-medium text-warm"></span>
          </div>
        </div>
      </div>

      <!-- What happens next -->
      <div
        class="rounded-2xl p-6 mb-6"
        style="background:white; border:1px solid rgba(29,78,95,0.08);"
      >
        <h2 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color:#1D4E5F;">
          What happens next
        </h2>
        <div class="space-y-4">
          {[
            {
              step: '1',
              title: 'Confirmation email',
              desc: 'Sent immediately with your Microsoft Teams link and all session details.',
              color: '#1D4E5F',
            },
            {
              step: '2',
              title: '48-hour reminder',
              desc: "A friendly reminder two days before your session.",
              color: '#7A9E7E',
            },
            {
              step: '3',
              title: '2-hour reminder',
              desc: 'A final reminder with your Teams link on the day.',
              color: '#C17D5C',
            },
          ].map(({ step, title, desc, color }) => (
            <div class="flex items-start gap-4">
              <div
                class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-semibold flex-shrink-0 mt-0.5"
                style={`background:${color};`}
              >
                {step}
              </div>
              <div>
                <p class="text-sm font-medium text-warm mb-0.5">{title}</p>
                <p class="text-xs leading-relaxed" style="color:#78716C;">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Cancellation notice -->
      <div
        class="rounded-xl p-4 mb-8 flex items-start gap-3"
        style="background:rgba(29,78,95,0.04); border:1px solid rgba(29,78,95,0.08);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1D4E5F" stroke-width="1.5" stroke-linecap="round" class="flex-shrink-0 mt-0.5">
          <circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>
        </svg>
        <p class="text-xs leading-relaxed" style="color:#44403C;">
          <strong class="font-medium">Cancellation policy:</strong> You may cancel free of charge up to
          48 hours before your session. Late cancellations are charged at the full session rate.
          To cancel, reply to your confirmation email.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/"
          class="flex-1 text-center py-3.5 text-sm font-medium rounded-xl text-white transition-all hover:opacity-90"
          style="background:linear-gradient(135deg,#1D4E5F,#2a6b82);"
        >
          Return to Home
        </a>
        <a
          href="/booking"
          class="flex-1 text-center py-3.5 text-sm font-medium rounded-xl transition-all bg-white"
          style="border:1.5px solid rgba(29,78,95,0.2); color:#1D4E5F;"
        >
          Book Another Session
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  @keyframes drawCheck {
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const name    = params.get('name');
  const service = params.get('service');
  const date    = params.get('date');
  const time    = params.get('time');
  const price   = params.get('price');
  const email   = params.get('email');

  // Summary text
  const summary = document.getElementById('booking-summary');
  if (summary && name) {
    const firstName = name.split(' ')[0];
    summary.textContent = email
      ? `Hi ${firstName} — your booking is confirmed. We've sent all the details to ${email}.`
      : `Your booking is confirmed. Check your email for the confirmation and Teams link.`;
  }

  // Details card
  if (service && date && time) {
    const card = document.getElementById('details-card');
    card?.classList.remove('hidden');

    const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-GB', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    const serviceEl = document.getElementById('detail-service');
    const dateEl    = document.getElementById('detail-date');
    const timeEl    = document.getElementById('detail-time');
    const priceEl   = document.getElementById('detail-price');

    if (serviceEl) serviceEl.textContent = service;
    if (dateEl)    dateEl.textContent    = formattedDate;
    if (timeEl)    timeEl.textContent    = `${time} (London time)`;
    if (priceEl)   priceEl.textContent   = price === '0' ? 'Free' : `£${price}`;
  }
</script>