---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INSURANCE_CONTACT_EMAIL } from '../config/booking';

const insurers = ['AXA Health', 'Aviva', 'Cigna', 'Healix', 'Vitality', 'Other'];
---

<BaseLayout
  title="Contact, Dr. Itzia Morales"
  description="Get in touch with Dr. Itzia Morales for general enquiries and bookings with health insurance (AXA, Aviva, Cigna, Healix, Vitality)."
>
  <section class="pt-32 pb-20" style="background:#FAF8F4;">
    <div class="section-container">
      <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-10">
          <a href="/" class="inline-flex items-center gap-2 text-sm mb-6" style="color:#78716C;">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M8 3L4 7.5L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Back to home
          </a>
          <h1 class="font-display text-display-md mb-3" style="color:#1C1917;">
            Get in <em class="not-italic" style="background:linear-gradient(135deg,#1D4E5F,#C17D5C); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">touch</em>
          </h1>
          <p class="text-sm leading-relaxed" style="color:#44403C;">
            Have a question, or want to book using your <strong>health insurance</strong>? Send a message below
            and I'll reply personally, usually within one working day. For a free 15-minute consultation or a
            self-funded session, please use the booking buttons instead.
          </p>
        </div>

        <!-- Quick info cards -->
        <div class="grid sm:grid-cols-3 gap-3 mb-8">
          <div class="p-4 rounded-xl" style="background:white; border:1px solid rgba(29,78,95,0.08);">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#1D4E5F;">Response time</p>
            <p class="text-xs" style="color:#78716C;">Within 1 working day</p>
          </div>
          <div class="p-4 rounded-xl" style="background:white; border:1px solid rgba(29,78,95,0.08);">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#1D4E5F;">Sessions</p>
            <p class="text-xs" style="color:#78716C;">Online via Microsoft Teams</p>
          </div>
          <div class="p-4 rounded-xl" style="background:white; border:1px solid rgba(29,78,95,0.08);">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#1D4E5F;">Confidential</p>
            <p class="text-xs" style="color:#78716C;">GDPR compliant</p>
          </div>
        </div>

        <!-- Card -->
        <div class="rounded-2xl p-6 sm:p-8" style="background:white; border:1px solid rgba(29,78,95,0.08);">
          <form id="contact-form" novalidate>
            <!-- Honeypot -->
            <div style="position:absolute; left:-9999px;" aria-hidden="true">
              <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- Your details -->
            <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#1D4E5F;">Your details</p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="cf-label">Full name *</label>
                <input id="f-name" type="text" required class="cf-input" placeholder="Your full name" />
              </div>
              <div>
                <label class="cf-label">Email *</label>
                <input id="f-email" type="email" required class="cf-input" placeholder="you@example.com" />
              </div>
              <div>
                <label class="cf-label">Phone (optional)</label>
                <input id="f-phone" type="tel" class="cf-input" placeholder="+44 …" />
              </div>
              <div>
                <label class="cf-label">Preferred reply</label>
                <select id="f-contact" class="cf-input">
                  <option>Email</option>
                  <option>Phone</option>
                  <option>Either</option>
                </select>
              </div>
            </div>

            <!-- Enquiry type -->
            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#1D4E5F;">What is your enquiry about?</p>
              <select id="f-topic" class="cf-input">
                <option>General enquiry</option>
                <option>Booking with insurance</option>
                <option>Block booking (multiple sessions)</option>
                <option>Question about a service or therapy</option>
                <option>Something else</option>
              </select>
            </div>

            <!-- Insurance details (shown only for insurance enquiries) -->
            <div id="insurance-block" class="mt-6 p-5 rounded-xl hidden" style="background:rgba(29,78,95,0.04); border:1px solid rgba(29,78,95,0.1);">
              <p class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color:#1D4E5F;">Insurance details</p>
              <p class="text-xs mb-4" style="color:#78716C;">
                Insurers require pre-authorisation before your first session. Share your details below and I'll confirm your cover and book you in.
              </p>

              <label class="cf-label">Your insurer</label>
              <div class="flex flex-wrap gap-2 mb-4" id="insurer-group">
                {insurers.map((ins) => (
                  <label class="cf-pill">
                    <input type="radio" name="insurer" value={ins} />
                    <span>{ins}</span>
                  </label>
                ))}
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="cf-label">Membership / policy no.</label>
                  <input id="f-policy" type="text" class="cf-input" placeholder="e.g. 1234567890" />
                </div>
                <div>
                  <label class="cf-label">Authorisation no.</label>
                  <input id="f-auth" type="text" class="cf-input" placeholder="From your insurer" />
                </div>
              </div>
            </div>

            <!-- Message -->
            <div class="mt-6">
              <label class="cf-label">Message *</label>
              <textarea id="f-message" rows="5" required class="cf-input" placeholder="How can I help? Feel free to mention what you're seeking support with and any preferred days or times."></textarea>
            </div>

            <!-- Consent -->
            <label class="flex items-start gap-2.5 mt-5 cursor-pointer">
              <input id="f-consent" type="checkbox" class="mt-0.5 flex-shrink-0" style="accent-color:#1D4E5F; width:16px; height:16px;" />
              <span class="text-xs leading-relaxed" style="color:#44403C;">
                I agree to the <a href="/privacy" class="underline underline-offset-2" style="color:#1D4E5F;">Privacy Policy</a>
                and consent to Dr. Itzia Morales contacting me about my enquiry. *
              </span>
            </label>

            <p id="cf-error" class="text-sm mt-4 hidden" style="color:#DC2626;"></p>

            <button id="cf-submit" type="submit"
              class="w-full mt-5 py-4 text-white font-medium rounded-xl text-sm transition-all hover:opacity-90 flex items-center justify-center gap-2"
              style="background:linear-gradient(135deg,#1D4E5F,#2a6b82);">
              Send message
            </button>

            <p class="text-xs mt-4 text-center" style="color:#78716C;">
              Prefer email? Write to
              <a href={`mailto:${INSURANCE_CONTACT_EMAIL}`} class="underline underline-offset-2" style="color:#1D4E5F;">{INSURANCE_CONTACT_EMAIL}</a>
              or call <a href="tel:+442030511593" class="underline underline-offset-2" style="color:#1D4E5F;">020 3051 1593</a>.
            </p>
          </form>

          <!-- Success state -->
          <div id="cf-success" class="hidden text-center py-8">
            <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4" style="background:rgba(122,158,126,0.15);">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#5a8260" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
            </div>
            <h2 class="font-display text-xl mb-2" style="color:#1C1917;">Message sent</h2>
            <p class="text-sm" style="color:#44403C;">Thank you. I'll get back to you as soon as possible.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cf-label { display:block; font-size:0.8rem; font-weight:500; color:#1C1917; margin-bottom:0.375rem; }
  .cf-input {
    width:100%; padding:0.7rem 0.9rem; border-radius:0.75rem;
    border:1.5px solid rgba(29,78,95,0.15); font-size:0.875rem; color:#1C1917;
    background:white; outline:none; transition:border-color 0.2s;
  }
  .cf-input:focus { border-color:#1D4E5F; }
  textarea.cf-input { resize:vertical; }
  /* Insurer pills */
  .cf-pill { cursor:pointer; }
  .cf-pill input { position:absolute; opacity:0; pointer-events:none; }
  .cf-pill span {
    display:inline-block; padding:0.4rem 0.85rem; border-radius:9999px;
    font-size:0.8rem; font-weight:500; color:#44403C; background:white;
    border:1.5px solid rgba(29,78,95,0.18); transition:all 0.15s;
  }
  .cf-pill input:checked + span {
    background:#1D4E5F; color:white; border-color:#1D4E5F;
  }
</style>

<script>
  const loadedAt = Date.now(); // anti-bot: measure how long the form was on screen
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errEl = document.getElementById('cf-error');
  const btn = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('cf-success');
  const topicEl = document.getElementById('f-topic') as HTMLSelectElement | null;
  const insBlock = document.getElementById('insurance-block');

  function toggleInsurance() {
    if (!topicEl || !insBlock) return;
    insBlock.classList.toggle('hidden', topicEl.value !== 'Booking with insurance');
  }
  topicEl?.addEventListener('change', toggleInsurance);

  // Pre-select topic from the URL (?topic=insurance | block)
  const urlTopic = new URLSearchParams(window.location.search).get('topic');
  if (urlTopic === 'insurance' && topicEl) {
    topicEl.value = 'Booking with insurance';
  } else if (urlTopic === 'block' && topicEl) {
    topicEl.value = 'Block booking (multiple sessions)';
    const msg = document.getElementById('f-message') as HTMLTextAreaElement | null;
    if (msg && !msg.value) {
      msg.value =
        "I'd like to enquire about a block booking. Please let me know the next steps.\n\n" +
        '- Block I’m interested in (e.g. 8-session Core): \n' +
        '- Preferred days/times: ';
    }
  }
  toggleInsurance();

  function val(id: string) {
    return (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value || '';
  }
  function showError(text: string) {
    if (errEl) { errEl.textContent = text; errEl.classList.remove('hidden'); }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl?.classList.add('hidden');

    const consent = (document.getElementById('f-consent') as HTMLInputElement | null)?.checked;
    const insurer = (form.querySelector('input[name="insurer"]:checked') as HTMLInputElement | null)?.value || '';

    const payload = {
      name: val('f-name'),
      email: val('f-email'),
      phone: val('f-phone'),
      preferredContact: val('f-contact'),
      topic: val('f-topic'),
      insurer,
      policyNumber: val('f-policy'),
      authNumber: val('f-auth'),
      message: val('f-message'),
      company: (form.querySelector('[name="company"]') as HTMLInputElement)?.value || '',
      elapsed: Date.now() - loadedAt,
    };

    if (!payload.name.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email) || payload.message.trim().length < 5) {
      showError('Please enter your name, a valid email, and a short message.');
      return;
    }
    if (!consent) {
      showError('Please agree to the Privacy Policy so I can reply to you.');
      return;
    }

    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error((data as any).error || 'Something went wrong.');
      form.classList.add('hidden');
      successEl?.classList.remove('hidden');
    } catch (err: any) {
      showError(err.message || 'Could not send your message. Please email us directly.');
      if (btn) { btn.disabled = false; btn.textContent = 'Send message'; }
    }
  });
</script>
