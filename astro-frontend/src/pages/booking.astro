---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Book a Session — Dr. Itzia Perez Morales">
  <section class="pt-32 pb-20" style="background: #FAF8F4;">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="font-display text-display-lg mb-4"
            style="color: #1C1917;">
          Book a <em class="not-italic"
            style="background: linear-gradient(135deg, #1D4E5F, #C17D5C);
                   -webkit-background-clip: text;
                   -webkit-text-fill-color: transparent;">
            Session
          </em>
        </h1>
        <p style="color: #44403C;">
          Choose a service below, pick a time that works for you,
          and pay securely. Your confirmation arrives instantly.
        </p>
      </div>

      <!-- Calendly inline embed -->
      <div class="max-w-4xl mx-auto rounded-2xl overflow-hidden"
           style="min-height: 700px; border: 1px solid rgba(0,0,0,0.06);">
        <div class="calendly-inline-widget"
             data-url="https://calendly.com/itzia-morales?hide_gdpr_banner=1&primary_color=1D4E5F"
             style="min-width: 320px; height: 700px;">
        </div>
      </div>
    </div>
  </section>

  <!-- Calendly script -->
  <script
    type="text/javascript"
    src="https://assets.calendly.com/assets/external/widget.js"
    async>
  </script>
</BaseLayout>