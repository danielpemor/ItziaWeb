---
import { ZANDA_BOOKING_URL } from '../config/booking';
// In redirect mode nothing links here, but old bookmarks / cached links to
// /booking should still land in the right place, so we forward to the
// Zanda Client Portal immediately.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${ZANDA_BOOKING_URL}`} />
    <link rel="canonical" href={ZANDA_BOOKING_URL} />
    <title>Redirecting to booking…</title>
    <script is:inline define:vars={{ url: ZANDA_BOOKING_URL }}>
      window.location.replace(url);
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; background:#FAF8F4; color:#44403C; display:flex; min-height:100vh; align-items:center; justify-content:center; margin:0;">
    <p style="font-size:0.95rem;">
      Taking you to the booking portal…
      <a href={ZANDA_BOOKING_URL} style="color:#1D4E5F;">Click here</a> if nothing happens.
    </p>
  </body>
</html>
