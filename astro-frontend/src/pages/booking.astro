---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ZANDA_BOOKING_URL } from '../config/booking';
---

<BaseLayout title="Book a Session — Dr. Itzia Perez Morales">
  <section class="pt-32 pb-20" style="background: #FAF8F4;">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="font-display text-display-lg mb-4"
            style="color: #1C1917;">
          Book a <em class="not-italic"
            style="background: linear-gradient(135deg, #1D4E5F, #C17D5C);
                   -webkit-background-clip: text;
                   -webkit-text-fill-color: transparent;">
            Session
          </em>
        </h1>
        <p style="color: #44403C;">
          Choose a service below, pick a time that works for you,
          and pay securely. Your confirmation arrives instantly.
        </p>
      </div>

      <!-- Zanda online-booking widget (embedded) -->
      <div class="booking-embed mx-auto rounded-2xl overflow-hidden"
           style="border: 1px solid rgba(0,0,0,0.06); background:#fff;">
        <iframe
          id="zanda-frame"
          src={ZANDA_BOOKING_URL}
          title="Book a session with Dr. Itzia Perez Morales"
          loading="lazy"
          allow="payment"
          referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
      </div>

      <p class="text-center text-xs mt-4" style="color:#78716C;">
        Secure payment via Stripe · GDPR compliant · Cancel free up to 48h before.
      </p>
    </div>
  </section>

  <script>
    // Deep-link a specific service when arriving as /booking?service=…
    // The site sends internal service ids; Zanda receives them in its
    // booking URL so the right service is pre-selected.
    const frame = document.getElementById('zanda-frame');
    const base = frame && frame.getAttribute('src');
    const service = new URLSearchParams(window.location.search).get('service');
    if (frame && base && service) {
      const sep = base.includes('?') ? '&' : '?';
      frame.setAttribute('src', base + sep + 'service=' + encodeURIComponent(service));
    }
  </script>
</BaseLayout>

<style>
  /* Responsive, mobile-friendly embed: full width, comfortable height that
     adapts to the viewport instead of a fixed 700px box. */
  .booking-embed {
    max-width: 56rem;          /* matches the old max-w-4xl */
    width: 100%;
  }
  .booking-embed iframe {
    display: block;
    width: 100%;
    height: clamp(620px, 80vh, 920px);
    border: 0;
  }
  @media (max-width: 640px) {
    .booking-embed {
      border-radius: 1rem;
    }
    .booking-embed iframe {
      height: calc(100vh - 9rem); /* near full-screen on phones */
      min-height: 560px;
    }
  }
</style>
