---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terms of Service, Dr. Itzia Perez Morales">
  <section class="pt-32 pb-20" style="background: #FAF8F4;">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">

        <!-- Header -->
        <div class="mb-14">
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium uppercase tracking-widest mb-6"
            style="background: rgba(29,78,95,0.08); color: #1D4E5F; border: 1px solid rgba(29,78,95,0.12);"
          >
            Legal
          </div>
          <h1 class="font-display text-display-lg leading-tight mb-4" style="color: #1C1917;">
            Terms of Service
          </h1>
          <p class="text-sm" style="color: #78716C;">
            Last updated: January 2025
          </p>
        </div>

        <!-- Content -->
        <div class="space-y-10">

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">1. Overview</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              These terms govern the use of this website and the clinical psychology
              services provided by Dr. Itzia Perez Morales. By booking a session or
              using this website, you agree to these terms.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">2. Services</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              I provide online psychological assessment and intervention for children,
              adolescents, and adults. All services are delivered by a HCPC-registered
              and BPS-chartered Clinical Psychologist. Services are provided via secure
              video call and are available to individuals based in the United Kingdom.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">3. Fees &amp; Payment</h2>
            <div class="overflow-x-auto rounded-xl mb-4" style="border: 1px solid rgba(0,0,0,0.06);">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr style="background: #F9FAFB;">
                    <th class="px-5 py-3 text-xs font-medium uppercase tracking-wider" style="color: #78716C;">Service</th>
                    <th class="px-5 py-3 text-xs font-medium uppercase tracking-wider text-right" style="color: #78716C;">Fee</th>
                  </tr>
                </thead>
                <tbody style="color: #44403C;">
                  <tr style="border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">Free Consultation (15 min)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #7A9E7E;">Free</td>
                  </tr>
                  <tr style="background: #FAFAF9; border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">Assessment (60 min)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #1D4E5F;">£140</td>
                  </tr>
                  <tr style="border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">Psychological Intervention (50 min)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #1D4E5F;">£120</td>
                  </tr>
                  <tr style="background: #FAFAF9; border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">EMDR Extended (90 min / 2 hr)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #1D4E5F;">£180 / £240</td>
                  </tr>
                  <tr style="border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">Follow-Up (30 min)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #1D4E5F;">£60</td>
                  </tr>
                  <tr style="background: #FAFAF9; border-top: 1px solid rgba(0,0,0,0.04);">
                    <td class="px-5 py-3">Medico-Legal (hourly)</td>
                    <td class="px-5 py-3 text-right font-medium" style="color: #1D4E5F;">£150</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              All fees are agreed at the time of initial enquiry. Payment is made prior to
              the session via the booking system (Stripe). Session packages are available for
              self-funded clients after the initial assessment and are agreed based on the
              treatment plan discussed. For full pricing including insured rates and packages,
              see the <a href="/fees" class="underline underline-offset-2" style="color: #1D4E5F;">Fees page</a>.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">4. Cancellation Policy</h2>
            <div
              class="p-5 rounded-xl mb-4"
              style="background: rgba(193,125,92,0.06); border: 1px solid rgba(193,125,92,0.12);"
            >
              <p class="text-sm font-medium mb-2" style="color: #C17D5C;">Important</p>
              <ul class="space-y-2 text-sm" style="color: #44403C;">
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0" style="background: #C17D5C;"></span>
                  <span>Cancellations made <strong>more than 48 hours</strong> before the appointment are free of charge.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0" style="background: #C17D5C;"></span>
                  <span>Late cancellations, within <strong>48 hours</strong>, are charged at the <strong>full session rate</strong> unless the session can be rescheduled within the same week.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0" style="background: #C17D5C;"></span>
                  <span>Non-attendance without notice is charged at the full session rate.</span>
                </li>
              </ul>
            </div>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">5. Confidentiality</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              All information shared during sessions is strictly confidential and governed by
              HCPC and BPS codes of conduct. Confidentiality may only be broken in exceptional
              circumstances where there is a significant risk of harm to you or others, or
              where disclosure is required by law (e.g. court order, safeguarding concerns).
              Any such decision would be discussed with you wherever possible.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">6. Insurance Clients</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              I am a registered provider with AXA, Aviva, Cigna, Healix, and Vitality.
              If you are accessing therapy through insurance, please confirm your cover and
              obtain an authorisation number from your insurer before your first session.
              You are responsible for any fees not covered by your insurance policy.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">7. Limitations</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              This service does not provide crisis support. If you are in immediate danger or
              experiencing a mental health crisis, please contact the NHS on 111, call 999,
              or go to your nearest A&amp;E department. You can also contact the
              <a href="https://www.samaritans.org" target="_blank" rel="noopener noreferrer"
                class="underline underline-offset-2" style="color: #1D4E5F;">Samaritans</a>
              on 116 123 (free, 24/7).
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">8. Complaints</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              I aim to provide the highest standard of care. If you are dissatisfied with any
              aspect of the service, please raise it with me directly in the first instance.
              If the matter is not resolved, you may contact the
              <a href="https://www.hcpc-uk.org/complaints/" target="_blank" rel="noopener noreferrer"
                class="underline underline-offset-2" style="color: #1D4E5F;">HCPC</a> or the
              <a href="https://www.bps.org.uk/public/complaints" target="_blank" rel="noopener noreferrer"
                class="underline underline-offset-2" style="color: #1D4E5F;">BPS</a>.
            </p>
          </div>

          <div>
            <h2 class="font-display text-xl mb-3" style="color: #1C1917;">9. Contact</h2>
            <p style="color: #44403C;" class="leading-relaxed text-sm">
              Dr. Itzia Perez Morales<br />
              <a href="mailto:itzia.morales@outlook.com" class="underline underline-offset-2" style="color: #1D4E5F;">itzia.morales@outlook.com</a>
            </p>
          </div>

        </div>

        <!-- Back link -->
        <div class="mt-14 pt-8" style="border-top: 1px solid rgba(29,78,95,0.08);">
          <a href="/"
            class="inline-flex items-center gap-2 text-sm font-medium transition-colors duration-200"
            style="color: #1D4E5F;"
          >
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to Home
          </a>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>