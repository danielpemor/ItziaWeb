---
const currentYear = new Date().getFullYear();
---

<footer class="bg-warm text-white/80 py-16">
  <div class="section-container">
    <div class="grid md:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-full bg-sage-400 flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M8 1C4.13 1 1 4.13 1 8s3.13 7 7 7 7-3.13 7-7-3.13-7-7-7zm0 2.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5zm0 9.5a5.5 5.5 0 01-4.33-2.1A3.5 3.5 0 018 9.5a3.5 3.5 0 014.33 1.4A5.5 5.5 0 018 13z" fill="white"/>
            </svg>
          </div>
          <span class="font-display text-lg font-medium text-white">Dr. Itzia Perez</span>
        </div>
        <p class="text-sm leading-relaxed text-white/60 max-w-xs mb-6">
          Chartered Clinical Psychologist offering evidence-based therapy,
          psychiatric assessment, and psychological coaching in London and online.
        </p>
        <div class="flex items-center gap-3">
          <img
            src="https://www.hcpc-uk.org/globalassets/resources/logos/hcpc-logo.svg"
            alt="HCPC Registered"
            class="h-8 opacity-60 filter brightness-0 invert"
            onerror="this.style.display='none'"
          />
          <div class="px-3 py-1.5 border border-white/20 rounded-full text-xs text-white/60">
            HCPC Registered
          </div>
          <div class="px-3 py-1.5 border border-white/20 rounded-full text-xs text-white/60">
            BPS Member
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-medium text-white mb-4 uppercase tracking-wider">Services</h4>
        <ul class="space-y-2.5">
          {[
            ['Individual Therapy', '/booking?service=individual-therapy'],
            ['Psychiatric Assessment', '/booking?service=psychiatric-assessment'],
            ['Couples Therapy', '/booking?service=couples-therapy'],
            ['ADHD Coaching', '/booking?service=adhd-coaching'],
          ].map(([label, href]) => (
            <li>
              <a href={href} class="text-sm text-white/60 hover:text-sage-300 transition-colors hover-underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h4 class="text-sm font-medium text-white mb-4 uppercase tracking-wider">Information</h4>
        <ul class="space-y-2.5">
          {[
            ['About', '/#about'],
            ['My Approach', '/#approach'],
            ['FAQ', '/#faq'],
            ['Privacy Policy', '/privacy'],
            ['Complaints Policy', '/complaints'],
          ].map(([label, href]) => (
            <li>
              <a href={href} class="text-sm text-white/60 hover:text-sage-300 transition-colors hover-underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/40">
        © {currentYear} Dr. Itzia Perez. All rights reserved.
        Registered in England & Wales.
      </p>
      <div class="flex items-center gap-1.5 text-xs text-white/40">
        <span>Payments secured by</span>
        <svg viewBox="0 0 60 25" class="h-4 opacity-50 fill-current">
          <text x="0" y="20" font-size="20" font-family="serif" font-weight="bold">Stripe</text>
        </svg>
      </div>
    </div>
  </div>
</footer>